        "mega",
        "quina",
        "lotofacil"
      ]
    },
    "draw_no": {
      "type": "number"
    },
    "draw_date": {
      "type": "string"
    },
    "numbers": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "sum": {
      "type": "number"
    },
    "odd_count": {
      "type": "number"
    }
  },
